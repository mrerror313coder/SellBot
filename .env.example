# ========================================================
# SellBot - Autonomous WhatsApp Sales Agent ($0 Budget)
# ========================================================

# AI Inference Layer (Groq Cloud — 100% Free Tier, Gemma 2 9B)
# Get free key at: https://console.groq.com (No credit card needed)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=gemma2-9b-it

# AI Backup Layer (Ollama — Local Laptop Fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Google Generative AI (Optional Free Embeddings & Reasoning Backup)
GEMINI_API_KEY=

# Database (MongoDB Atlas Free Tier / Pro / Local MongoDB)
# Can leave empty or default to test with local JSON storage fallback
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/sellbot

# WhatsApp Layer (Baileys — Free Open Source Socket API)
WHATSAPP_SESSION_PATH=./auth/baileys-session
ENABLE_WHATSAPP_AUTOSTART=false

# Hosting & Server Settings
PORT=8080
NODE_ENV=development

# Tracing & Telemetry (Sentry Free Tier — 5,000 errors/month free)
SENTRY_DSN=

# Store Default Configuration (Priya's Cakes)
STORE_NAME=Priya's Cakes
STORE_UPI=priya@paytm
STORE_CURRENCY=INR
STORE_PHONE=+919876543210
STORE_UPSELL_AGGRESSIVENESS=0.5

# Voice Synthesis (Edge TTS — Free Microsoft Neural Voices)
TTS_VOICE_EN=en-US-JennyNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_ES=es-MX-DaliaNeural
TTS_VOICE_AR=ar-SA-ZariyahNeural
TTS_VOICE_PT=pt-BR-FranciscaNeural
